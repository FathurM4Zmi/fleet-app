# Salin ke .env lalu isi nilainya. File .env di-ignore git.
# Untuk deploy Vercel, isi variabel di bawah ini di
# Project Settings → Environment Variables (Production + Preview), bukan di file ini.
# EXPO_PUBLIC_API_URL=https://api.contoh.com

# MapTiler API key — dipakai basemap di src/components/MapCanvas.native.tsx (MapLibre)
# dan fallback raster web di src/components/MapCanvas.tsx.
# Buat key di https://cloud.maptiler.com/account/keys/
EXPO_PUBLIC_MAPTILER_API_KEY=
# Opsional: gaya peta MapTiler (default streets-v2).
# EXPO_PUBLIC_MAPTILER_STYLE=streets-v2
